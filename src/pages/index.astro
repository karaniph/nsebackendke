---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexContent from '../components/IndexContent';

import { fetchLivePosts } from '../lib/live-blog';
import { getPublishedPostSummaries, getPostSummariesByCategoryFrom, sortPublishedPosts } from '../lib/blog-data';

// Fetch the data on the server during build (or SSR request)
const rawPosts = await fetchLivePosts();
const allPostsFull = sortPublishedPosts(rawPosts || []);
const allPosts = allPostsFull.map(({ content, blocks, ...rest }) => rest);
const news = getPostSummariesByCategoryFrom(allPosts, "news");
const marketBriefs = getPostSummariesByCategoryFrom(allPosts, "market-briefs");
const deepDives = getPostSummariesByCategoryFrom(allPosts, "deep-dives");
const education = getPostSummariesByCategoryFrom(allPosts, "education");
const botUpdates = getPostSummariesByCategoryFrom(allPosts, "bot-updates");

const todayBrief = allPostsFull.find(p => p.category === "market-briefs");

const seoDescription = "Daily NSE market briefs, Kenya stock analysis, and an AI investment advisor that helps investors explore portfolio strategies using NSE filings and market context.";
const seoKeywords = ["NSE", "Nairobi Securities Exchange", "Kenya stocks", "market briefs", "investment education", "Kenya investing", "stock analysis", "AI investment advisor Kenya", "NSE investment advisor", "Kenya stock portfolio"];
---

<BaseLayout 
  title="NSEinsider — Kenya's Market Intelligence Platform"
  description={seoDescription}
  image="/og/site/default.png"
  keywords={seoKeywords}
>
  <!-- 
    We pass the server-fetched data into the React component as props.
    Only the interactive parts (like topic toggling) will run on the client.
    We'll use client:load to make sure React hydrates this component.
  -->
  <IndexContent 
    client:load 
    allPosts={allPosts}
    news={news}
    marketBriefs={marketBriefs}
    deepDives={deepDives}
    education={education}
    botUpdates={botUpdates}
    todayBrief={todayBrief}
  />
</BaseLayout>
