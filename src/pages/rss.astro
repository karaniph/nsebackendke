---
// src/pages/rss.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import RSSContent from '../components/RSSContent';
import { generateRSSFeed } from '../lib/blog-data';

const rssContent = generateRSSFeed();
---

<BaseLayout 
  title="RSS Feed"
  description="Subscribe to NSEinsider via RSS."
  noindex={true}
>
  <div class="container py-12 md:py-16 max-w-3xl animate-in-up">
    <RSSContent client:load rssContent={rssContent} />
  </div>
</BaseLayout>
