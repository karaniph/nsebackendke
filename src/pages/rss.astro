---
// src/pages/rss.astro
// Human-friendly landing for the feed. Previously this rendered a React island
// fed by generateRSSFeed(), which only knew the four hardcoded posts — shipping
// client JS to display a stale 4-item feed on a noindex page. The real feed is
// the build-time /rss.xml route.
import BaseLayout from '../layouts/BaseLayout.astro';

const FEED_URL = 'https://nseinsider.co.ke/rss.xml';
---

<BaseLayout
  title="RSS Feed"
  description="Subscribe to NSEinsider via RSS."
  noindex={true}
>
  <div class="container py-12 md:py-16 max-w-2xl animate-in-up flex-1">
    <h1 class="text-3xl font-heading font-bold text-foreground mb-3">RSS Feed</h1>
    <p class="text-muted-foreground mb-6">
      Follow NSEinsider in your reader. Add this feed URL to any RSS client:
    </p>
    <div class="content-card p-4 md:p-5">
      <code class="text-sm break-all text-foreground">{FEED_URL}</code>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      <a href="/rss.xml" class="btn-brand text-sm">Open the feed</a>
      <a href="/blog" class="btn-outline text-sm">Browse all posts</a>
    </div>
  </div>
</BaseLayout>
