---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogContent from '../../components/BlogContent';

import { fetchLivePosts } from '../../lib/live-blog';
import { sortPublishedPosts } from '../../lib/blog-data';

const rawPosts = await fetchLivePosts();
const allPostsRaw = sortPublishedPosts(rawPosts || []);
const allPosts = allPostsRaw.map(({ content, blocks, ...rest }) => rest);

const seoDescription = "All NSEinsider blog posts — daily market briefs, company deep dives, and practical investor education for the Nairobi Securities Exchange.";
const seoKeywords = ["NSEinsider blog", "NSE market analysis", "Kenya stocks", "Nairobi Securities Exchange", "investor education"];
---

<BaseLayout 
  title="Blog"
  description={seoDescription}
  image="/og/site/market-briefs.png"
  keywords={seoKeywords}
>
  <BlogContent client:load allPosts={allPosts} />
</BaseLayout>
