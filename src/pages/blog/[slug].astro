---
// src/pages/blog/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogPostContent from '../../components/BlogPostContent';

import { fetchLivePosts } from '../../lib/live-blog';
import {
  sortPublishedPosts,
  getRelatedPostsFrom,
  getAdjacentPostsFrom,
  CATEGORY_LABELS,
  type BlogPost,
  type BlogPostCard,
} from '../../lib/blog-data';
import {
  getPostMetaDescription,
  getPostOgImage,
  extractKeyTakeaways,
  extractHeadings,
  extractSourceUrls,
  estimateReadingMinutes,
  normalizePostMarkdown,
  toPostCard,
} from '../../lib/post-intelligence';
import { renderPostHtml } from '../../lib/markdown';
import { buildVisualBlocks } from '../../lib/visual-blocks';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo-schema';

export async function getStaticPaths() {
  // Astro hoists getStaticPaths, so anything it uses must be an import or a
  // hoisted function declaration — not a frontmatter const.
  const RELATED_LIMIT = 6;
  const allPosts = await fetchLivePosts();
  const published = sortPublishedPosts(allPosts || []);

  return published.map((post) => {
    const { prev, next } = getAdjacentPostsFrom(published, post.slug);
    return {
      params: { slug: post.slug },
      props: {
        post,
        related: getRelatedPostsFrom(published, post, RELATED_LIMIT).map(toPostCard),
        prev: prev ? toPostCard(prev) : null,
        next: next ? toPostCard(next) : null,
      },
    };
  });
}

const { post, related, prev, next } = Astro.props as {
  post: BlogPost;
  related: BlogPostCard[];
  prev: BlogPostCard | null;
  next: BlogPostCard | null;
};

if (!post) {
  return Astro.redirect('/404');
}

const metaDescription = getPostMetaDescription(post);
const ogImage = getPostOgImage(post.slug);
const pageUrl = new URL(`/blog/${post.slug}/`, Astro.site ?? 'https://nseinsider.co.ke').href;
const categoryLabel = CATEGORY_LABELS[post.category] ?? 'Blog';
const publishedIso = new Date(post.date).toISOString();
const modifiedIso = new Date(post.updatedAt || post.date).toISOString();

// Everything derived from the body is computed here, at build time, so the
// client island ships neither the markdown libraries nor the raw markdown.
const normalizedContent = normalizePostMarkdown(post.content, post.title);
const wordCount = normalizedContent.split(/\s+/).filter(Boolean).length;
const headings = extractHeadings(normalizedContent);
const contentHtml = renderPostHtml(normalizedContent, headings);
const readMinutes = estimateReadingMinutes(normalizedContent);
const sourceCount = extractSourceUrls(normalizedContent).length;
const keyTakeaways = extractKeyTakeaways(normalizedContent, 3);
const visualBlocks = buildVisualBlocks({ ...post, content: normalizedContent });
const postCard = toPostCard(post);

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: categoryLabel, url: `/category/${post.category}` },
  { name: post.title },
];

// FAQPage for education posts. Answers are drawn from the post itself rather
// than fixed boilerplate. Note Google restricted FAQ rich results to health and
// government sites in 2023, so treat this as machine-readable Q&A rather than a
// SERP feature.
const takeaways = extractKeyTakeaways(normalizedContent, 2);
const faq = post.category === 'education'
  ? [
      {
        question: `What does "${post.title}" cover?`,
        answer: post.description,
      },
      ...(takeaways[0]
        ? [{ question: 'What is the key takeaway?', answer: takeaways[0] }]
        : []),
      {
        question: 'Is this investment advice?',
        answer:
          'No. NSEinsider publishes educational and research material for decision support only. Nothing here is investment advice, and you should consult a licensed financial advisor before investing on the NSE.',
      },
    ]
  : null;

const schemas = [
  articleSchema({
    pageUrl,
    headline: post.title,
    description: metaDescription,
    image: ogImage,
    datePublished: publishedIso,
    dateModified: modifiedIso,
    authorName: post.author,
    authorRole: post.authorRole,
    section: categoryLabel,
    keywords: post.tags,
    wordCount,
    hasBreadcrumb: true,
  }),
  breadcrumbSchema(breadcrumbItems, pageUrl),
  ...(faq ? [faqSchema(faq, pageUrl)] : []),
];
---

<BaseLayout
  title={post.title}
  description={metaDescription}
  image={ogImage}
  type="article"
  publishedDate={publishedIso}
  modifiedDate={modifiedIso}
  author={post.author}
  keywords={post.tags}
  schemas={schemas}
>
  <Breadcrumbs items={breadcrumbItems} />
  <BlogPostContent
    client:load
    post={postCard}
    contentHtml={contentHtml}
    headings={headings}
    keyTakeaways={keyTakeaways}
    readMinutes={readMinutes}
    sourceCount={sourceCount}
    visualBlocks={visualBlocks}
    related={related}
    prev={prev}
    next={next}
  />
</BaseLayout>
