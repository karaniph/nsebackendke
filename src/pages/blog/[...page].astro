---
// src/pages/blog/[...page].astro
// Static, paginated blog index: /blog/, /blog/2/, /blog/3/ ...
// PostCard is rendered server-side (no client directive), so these pages ship
// as plain HTML and every post gets crawlable internal links — the previous
// client-only pagination exposed just the first 12 posts to crawlers.
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PaginationNav from '../../components/PaginationNav.astro';
import PostCard from '../../components/PostCard';

import { fetchLivePosts } from '../../lib/live-blog';
import { sortPublishedPosts, type BlogPostCard } from '../../lib/blog-data';
import { toPostCard } from '../../lib/post-intelligence';
import { breadcrumbSchema } from '../../lib/seo-schema';

export const getStaticPaths = (async ({ paginate }) => {
  // Inlined: getStaticPaths is hoisted above frontmatter consts.
  const posts = sortPublishedPosts((await fetchLivePosts()) || []).map(toPostCard);
  return paginate(posts, { pageSize: 12 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<BlogPostCard> };

const pageTitle = page.currentPage > 1 ? `Blog — Page ${page.currentPage}` : 'Blog';
const seoDescription =
  'All NSEinsider blog posts — daily market briefs, company deep dives, and practical investor education for the Nairobi Securities Exchange.';

const pageUrl = new URL(page.url.current, Astro.site ?? 'https://nseinsider.co.ke').href;
const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'Blog', ...(page.currentPage > 1 ? { url: '/blog' } : {}) },
  ...(page.currentPage > 1 ? [{ name: `Page ${page.currentPage}` }] : []),
];
---

<BaseLayout
  title={pageTitle}
  description={seoDescription}
  image="/og/site/market-briefs.png"
  keywords={["NSEinsider blog", "NSE market analysis", "Kenya stocks", "Nairobi Securities Exchange", "investor education"]}
  schemas={[breadcrumbSchema(breadcrumbItems, pageUrl)]}
>
  <Breadcrumbs items={breadcrumbItems} />
  <div class="container py-12 md:py-16 animate-in-up flex-1">
    <div class="mb-10">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-foreground">Blog</h1>
      <p class="text-muted-foreground mt-2 max-w-lg">
        All posts — market briefs, deep dives, and investor education for the NSE.
      </p>
      <p class="text-sm text-muted-foreground mt-1">
        {page.total} post{page.total !== 1 ? 's' : ''} · page {page.currentPage} of {page.lastPage}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
      {page.data.map((post, i) => (
        <PostCard post={post} index={i} />
      ))}
    </div>

    <PaginationNav currentPage={page.currentPage} totalPages={page.lastPage} base="/blog/" />
  </div>
</BaseLayout>
