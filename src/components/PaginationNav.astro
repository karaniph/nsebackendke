---
// src/components/PaginationNav.astro
// Server-rendered pagination with real <a> links, so every page in a listing is
// crawlable. Replaces the client-only Pagination island whose page buttons only
// worked after hydration and produced no URLs for crawlers to follow.
interface Props {
  currentPage: number;
  totalPages: number;
  /** Base path with trailing slash, e.g. "/blog/" or "/category/education/". */
  base: string;
}

const { currentPage, totalPages, base } = Astro.props as Props;

/** Page 1 lives at the base path; later pages append the number. */
function href(page: number): string {
  return page <= 1 ? base : `${base}${page}/`;
}

function pageRange(current: number, total: number): (number | "gap")[] {
  if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
  const pages: (number | "gap")[] = [1];
  if (current > 3) pages.push("gap");
  for (let i = Math.max(2, current - 1); i <= Math.min(total - 1, current + 1); i++) pages.push(i);
  if (current < total - 2) pages.push("gap");
  pages.push(total);
  return pages;
}

const pages = pageRange(currentPage, totalPages);
---

{totalPages > 1 && (
  <nav aria-label="Pagination" class="flex items-center justify-center gap-1.5 mt-10 flex-wrap">
    {currentPage > 1 ? (
      <a href={href(currentPage - 1)} rel="prev" class="pagination-btn" aria-label="Previous page">Prev</a>
    ) : (
      <span class="pagination-btn pagination-btn--disabled" aria-disabled="true">Prev</span>
    )}

    {pages.map((p) =>
      p === "gap" ? (
        <span class="px-2 text-muted-foreground text-sm select-none">…</span>
      ) : (
        <a
          href={href(p)}
          aria-current={p === currentPage ? "page" : undefined}
          class={`pagination-num ${p === currentPage ? "pagination-num--active" : ""}`}
        >
          {p}
        </a>
      )
    )}

    {currentPage < totalPages ? (
      <a href={href(currentPage + 1)} rel="next" class="pagination-btn" aria-label="Next page">Next</a>
    ) : (
      <span class="pagination-btn pagination-btn--disabled" aria-disabled="true">Next</span>
    )}
  </nav>
)}
