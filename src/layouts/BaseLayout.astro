---
// src/layouts/BaseLayout.astro
import '../index.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  keywords?: string[];
  canonicalUrl?: string;
  noindex?: boolean;
  /** Page-specific JSON-LD nodes. Organization + WebSite are always added. */
  schemas?: any[];
  /** @deprecated single-node form, kept so existing callers keep working. */
  schema?: any;
}

const SITE_NAME = "NSEinsider";
const SITE_URL = "https://nseinsider.co.ke";
const DEFAULT_OG_IMAGE = "/og/site/default.png";

const {
  title,
  description,
  image = DEFAULT_OG_IMAGE,
  type = "website",
  publishedDate,
  modifiedDate,
  author,
  keywords,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href,
  noindex = false,
  schemas = [],
  schema
} = Astro.props;

import TickerBar from '../components/TickerBar';
import AppShell from '../components/AppShell';
import { buildGraph, organizationSchema, websiteSchema } from '../lib/seo-schema';

const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const resolvedImage = image.startsWith('http') ? image : `${SITE_URL}${image.startsWith('/') ? image : `/${image}`}`;

// Organization and WebSite ship on every page so Article / BreadcrumbList /
// FAQPage nodes can reference them by @id.
const jsonLdGraph = buildGraph([
  organizationSchema(),
  websiteSchema(),
  ...schemas,
  ...(schema ? [schema] : []),
]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="rW8_nC_eNRhTLdp_Qp_pZg9Mu8MZScYmVUWzPZx5srY" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Third-party origins used below; warm the connections early. -->
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="preconnect" href="https://www.clarity.ms" crossorigin />
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="googlebot" content={noindex ? "noindex,follow" : "index,follow"} />
    
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:secure_url" content={resolvedImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_KE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS Feed`} href={`${SITE_URL}/rss.xml`} />

    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}
    {author && <meta property="article:author" content={author} />}
    {author && <meta name="author" content={author} />}

    <link rel="canonical" href={canonicalUrl} />

    {jsonLdGraph && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />
    )}

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D9FF3CPD42"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-D9FF3CPD42');
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wd65aooupj");
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased selection:bg-accent selection:text-white">
    <!-- Optional: Add a client-side theme script to prevent flash of wrong theme -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('nse-theme')) {
          return localStorage.getItem('nse-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    
    <div class="relative flex min-h-screen flex-col">
      <TickerBar client:load />
      <AppShell client:load currentPath={Astro.url.pathname}>
        <slot />
      </AppShell>
    </div>
  </body>
</html>
