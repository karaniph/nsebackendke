---
// src/layouts/BaseLayout.astro
import '../index.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
  author?: string;
  keywords?: string[];
  canonicalUrl?: string;
  noindex?: boolean;
  schema?: any;
}

const SITE_NAME = "NSEinsider";
const SITE_URL = "https://nseinsider.co.ke";
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-market-briefs.svg`;

const {
  title,
  description,
  image = DEFAULT_OG_IMAGE,
  type = "website",
  publishedDate,
  author,
  keywords,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? SITE_URL).href,
  noindex = false,
  schema
} = Astro.props;

import TickerBar from '../components/TickerBar';
import AppShell from '../components/AppShell';

const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const resolvedImage = image.startsWith('http') ? image : `${SITE_URL}${image.startsWith('/') ? image : `/${image}`}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="rW8_nC_eNRhTLdp_Qp_pZg9Mu8MZScYmVUWzPZx5srY" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <meta name="googlebot" content={noindex ? "noindex,follow" : "index,follow"} />
    
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:site_name" content={SITE_NAME} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE_NAME} RSS Feed`} href={`${SITE_URL}/rss.xml`} />

    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {author && <meta property="article:author" content={author} />}

    <link rel="canonical" href={canonicalUrl} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-8863850669996838">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8863850669996838" crossorigin="anonymous"></script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wd65aooupj");
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased selection:bg-accent selection:text-white">
    <!-- Optional: Add a client-side theme script to prevent flash of wrong theme -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('nse-theme')) {
          return localStorage.getItem('nse-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    
    <div class="relative flex min-h-screen flex-col">
      <TickerBar client:load />
      <AppShell client:load currentPath={Astro.url.pathname}>
        <slot />
      </AppShell>
    </div>
  </body>
</html>
