---
// src/layouts/BaseLayout.astro
import '../index.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedDate?: string;
  author?: string;
  keywords?: string[];
  canonicalUrl?: string;
  schema?: any;
}

const SITE_NAME = "NSEinsider";
const SITE_URL = "https://nseinsider.co.ke";
const DEFAULT_OG_IMAGE = `${SITE_URL}/og-image.jpg`;

const {
  title,
  description,
  image = DEFAULT_OG_IMAGE,
  type = "website",
  publishedDate,
  author,
  keywords,
  canonicalUrl = Astro.url.href,
  schema
} = Astro.props;

import TickerBar from '../components/TickerBar';

const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const resolvedImage = image.startsWith('http') ? image : `${SITE_URL}${image.startsWith('/') ? image : `/${image}`}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="rW8_nC_eNRhTLdp_Qp_pZg9Mu8MZScYmVUWzPZx5srY" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    
    {keywords && keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:site_name" content={SITE_NAME} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    {author && <meta property="article:author" content={author} />}

    <link rel="canonical" href={canonicalUrl} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class="min-h-screen bg-background font-sans antialiased selection:bg-accent selection:text-white">
    <!-- Optional: Add a client-side theme script to prevent flash of wrong theme -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('nse-theme')) {
          return localStorage.getItem('nse-theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    
    <div class="relative flex min-h-screen flex-col">
      <TickerBar client:load />
      <slot />
    </div>
  </body>
</html>
